# Nethrasap platform — environment template.
# Copy to `.env` (gitignored) and fill in real values before running the backend.
# NOTE: there are deliberately NO email settings — the platform is phone/SMS based.

# --- App ---
ENVIRONMENT=dev                # dev | staging | production
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
#   Local:  postgresql://nethrasap:dev_only_password@localhost:5432/nethrasap
#   Render: internal connection string from the Render Postgres instance
DATABASE_URL=postgresql://nethrasap:dev_only_password@localhost:5432/nethrasap
TEST_DATABASE_URL=postgresql://nethrasap:dev_only_password@localhost:5432/nethrasap_test

# --- Redis (pub/sub for realtime + arq job queue + rate limiting) ---
#   Local:  redis://localhost:6379/0
#   Render: Render Key Value internal URL
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# REQUIRED. In staging/production the app refuses to boot with the placeholder.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_ME_run_python_secrets_token_urlsafe_64
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- SMS / OTP ---
# "console" logs OTPs to stdout for local dev. Swap to a real provider later
# (msg91 | exotel | twilio) — only these vars change, no code paths.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=NTHRSP

# --- Object storage (Cloudflare R2, S3-compatible) ---
# KYC documents, product images, invoice/payslip PDFs.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=nethrasap
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=          # public bucket/custom domain for product images

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontends ---
NEXT_PUBLIC_API_BASE=             # empty in dev (proxied); https://api.<domain> in prod
NEXT_PUBLIC_WS_BASE=              # wss://api.<domain> in prod
