# Backend image — serves the API and (with an overridden command) the arq worker.
# Build context is the repo root:  docker build -f infra/Dockerfile.backend .
#
# Two real stages: `builder` resolves the locked venv; `runtime` ships only the
# venv + the code the container actually runs. Tests and dev/seed scripts are
# deliberately left out of the runtime image (see the scoped scripts COPY below).

# ---- builder: build the locked virtualenv only ----
FROM python:3.12-slim AS builder

# uv for fast, locked installs. Pinned to a fixed version (not :latest) so image
# builds are reproducible and can't drift under us.
COPY --from=ghcr.io/astral-sh/uv:0.5.14 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# Install deps only — no app source, so this layer caches across code changes.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ---- test: builder + dev deps + tests, for CI and local runs (never shipped) ----
# Placed before `runtime` so `runtime` stays the default build target (compose
# builds the last stage). Build explicitly with:
#   docker build -f infra/Dockerfile.backend --target test -t nethrasap-api-test .
FROM builder AS test
WORKDIR /app
RUN uv sync --frozen
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/scripts ./scripts
COPY backend/tests ./tests

# ---- runtime: minimal image, no build tooling, no tests/dev scripts ----
FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# The resolved virtualenv from the builder (built at the same /app/.venv path,
# so its interpreter symlinks and console scripts stay valid).
COPY --from=builder /app/.venv ./.venv

# Application code + migration assets.
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/pyproject.toml ./pyproject.toml

# Scripts: ship ONLY what the Render preDeploy step invokes
#   preDeployCommand: alembic upgrade head
#                     && python -m scripts.seed_rbac
#                     && python -m scripts.bootstrap_admin
# seed_rbac imports seed_roles_and_permissions from scripts/rbac_data.py (a
# credential-free module), so only rbac_data rides along — seed.py (which holds
# the Demo123! demo fixtures) is deliberately NOT shipped. Also EXCLUDED:
# seed.py, seed_dev.py, reset_db.py, backfill_product_info.py, and tests/.
COPY backend/scripts/__init__.py \
     backend/scripts/rbac_data.py \
     backend/scripts/seed_rbac.py \
     backend/scripts/bootstrap_admin.py \
     ./scripts/

# Run as an unprivileged user.
RUN useradd -m -u 10001 app && chown -R app:app /app
USER app

EXPOSE 8000

# Render injects $PORT; default to 8000 for local `docker run`.
# Migrations + RBAC seed run in the Render pre-deploy step (see render.yaml):
#   alembic upgrade head && python -m scripts.seed_rbac
# --proxy-headers: production always sits behind a proxy (Render/Cloudflare/
# Caddy); trust X-Forwarded-* so audit logs record real client IPs and
# url_for/scheme are https-correct.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips '*'"]
