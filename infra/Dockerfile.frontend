# Shared multi-stage Dockerfile for both Next.js apps.
# Build with:  docker build -f infra/Dockerfile.frontend --build-arg APP=storefront .
#              docker build -f infra/Dockerfile.frontend --build-arg APP=dashboard .

FROM node:20-alpine AS deps
ARG APP
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/storefront/package.json apps/storefront/
COPY apps/dashboard/package.json apps/dashboard/
COPY packages/api-client/package.json packages/api-client/
COPY packages/ui/package.json packages/ui/
RUN npm ci

FROM node:20-alpine AS build
ARG APP
# Both are baked at BUILD time:
#  - API_PROXY_TARGET: the Next rewrite destination (server-side proxy). Used
#    for local dev / same-origin. Compose sets http://api:8000.
#  - NEXT_PUBLIC_API_BASE: absolute API URL inlined into the client bundle so
#    the browser calls the API directly (HTTP + WebSockets). Set in prod.
ARG API_PROXY_TARGET=http://localhost:8000
ARG NEXT_PUBLIC_API_BASE=""
# Where staff signed in on the storefront are pointed to reach the ops portal.
ARG NEXT_PUBLIC_DASHBOARD_URL=""
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 \
    API_PROXY_TARGET=${API_PROXY_TARGET} \
    NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE} \
    NEXT_PUBLIC_DASHBOARD_URL=${NEXT_PUBLIC_DASHBOARD_URL}
RUN npm run build --workspace "apps/${APP}"

FROM node:20-alpine AS run
ARG APP
# NEXT_PUBLIC_API_BASE is also kept at runtime for SSR server components.
ARG NEXT_PUBLIC_API_BASE=""
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
WORKDIR /app
# Standalone output contains a pruned node_modules + server.js, laid out
# from the monorepo root because of outputFileTracingRoot.
COPY --from=build /repo/apps/${APP}/.next/standalone ./
COPY --from=build /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /repo/apps/${APP}/public ./apps/${APP}/public
# ARG values aren't visible to CMD at runtime; bake the entry path.
RUN ln -s "apps/${APP}/server.js" server.js
EXPOSE 3000
CMD ["node", "server.js"]
