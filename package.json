{
  "name": "nethrasap-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "npm run dev --workspace @nethrasap/storefront",
    "dev:dashboard": "npm run dev --workspace nethrasap-dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate:api": "npm run generate --workspace @nethrasap/api-client"
  }
}
